#: app/Common/Abilities/Abilities.php:93
msgid "Get Post SEO Data"
msgstr ""

#: app/Common/Abilities/Abilities.php:94
msgid "Returns the SEO snapshot for a post: title, meta description, focus keywords, robots flags, canonical URL, social meta, schema type, pillar flag and TruSEO score. Optionally includes the full TruSEO analysis breakdown when \"analysis\" is passed in include."
msgstr ""

#: app/Common/Abilities/Abilities.php:101
#: app/Common/Abilities/Abilities.php:131
msgid "The post ID."
msgstr ""

#: app/Common/Abilities/Abilities.php:105
msgid "Optional list of additional sections. Currently supports: \"analysis\" (full TruSEO breakdown)."
msgstr ""

#: app/Common/Abilities/Abilities.php:123
msgid "Update Post SEO Data"
msgstr ""

#: app/Common/Abilities/Abilities.php:124
msgid "Updates SEO fields for a post: title, description, focus keyword, additional keywords, robots flags, canonical URL, pillar flag and social meta. Only the fields provided in input are changed; others are preserved. Fields not listed (e.g. schema, EEAT) are rejected — use the AIOSEO admin UI for those."
msgstr ""

#: app/Common/Abilities/Abilities.php:135
msgid "SEO title; pass null to clear and inherit the default."
msgstr ""

#: app/Common/Abilities/Abilities.php:167
msgid "List Posts Missing SEO Data"
msgstr ""

#: app/Common/Abilities/Abilities.php:168
msgid "Returns posts where one or more SEO fields are unset (title, description, or focus keyword). Defaults to focus_keyphrase. Useful for \"which posts need SEO attention?\" prompts."
msgstr ""

#: app/Common/Abilities/Abilities.php:214
msgid "List Posts by TruSEO Score"
msgstr ""

#: app/Common/Abilities/Abilities.php:215
msgid "Returns posts ordered by their TruSEO score, with optional min/max thresholds. Useful for finding the worst (or best) performing content."
msgstr ""

#: app/Common/Abilities/Abilities.php:279
msgid "Get AIOSEO Settings"
msgstr ""

#: app/Common/Abilities/Abilities.php:280
msgid "Returns the full AIOSEO settings tree. Read-only: settings cannot be modified via abilities — use the AIOSEO admin UI."
msgstr ""

#: app/Common/Abilities/Abilities.php:288
msgid "The AIOSEO settings tree. Shape is internal AIOSEO; treat as opaque structured data."
msgstr ""

#: app/Common/Abilities/Abilities.php:307
msgid "List Active Notifications"
msgstr ""

#: app/Common/Abilities/Abilities.php:308
msgid "Returns currently-active AIOSEO admin notifications (warnings, errors, action-required items). Pass include_dismissed=true to also list dismissed ones."
msgstr ""

#: app/Common/Abilities/Abilities.php:378
msgid "Get Robots.txt Output"
msgstr ""

#: app/Common/Abilities/Abilities.php:379
msgid "Returns the active robots.txt content that AIOSEO is serving for this site, including custom rules and WordPress defaults."
msgstr ""

#: app/Common/Abilities/Abilities.php:392
msgid "List Robots.txt Rules"
msgstr ""

#: app/Common/Abilities/Abilities.php:393
msgid "Lists AIOSEO's custom robots.txt rules. Each rule has a stable id usable with update/delete."
msgstr ""

#: app/Common/Abilities/Abilities.php:411
msgid "Add Robots.txt Rule"
msgstr ""

#: app/Common/Abilities/Abilities.php:412
msgid "Adds a new custom robots.txt rule for a given user agent. Directive must be \"allow\" or \"disallow\"."
msgstr ""

#: app/Common/Abilities/Abilities.php:419
msgid "User-agent the rule applies to (e.g. \"*\", \"Googlebot\")."
msgstr ""

#: app/Common/Abilities/Abilities.php:427
msgid "Path or pattern the directive applies to (e.g. \"/private/\")."
msgstr ""

#: app/Common/Abilities/Abilities.php:446
msgid "Update Robots.txt Rule"
msgstr ""

#: app/Common/Abilities/Abilities.php:447
msgid "Updates an existing custom robots.txt rule by its id. Only the fields provided are changed."
msgstr ""

#: app/Common/Abilities/Abilities.php:454
#: app/Common/Abilities/Abilities.php:487
msgid "Rule id from robots/rules/list."
msgstr ""

#: app/Common/Abilities/Abilities.php:479
msgid "Delete Robots.txt Rule"
msgstr ""

#: app/Common/Abilities/Abilities.php:480
msgid "Deletes a custom robots.txt rule by its id."
msgstr ""

#: app/Common/Abilities/Abilities.php:516
msgid "Get Homepage SEO Audit"
msgstr ""

#: app/Common/Abilities/Abilities.php:517
msgid "Returns the cached SEO Site Analysis scan for the homepage: score, totals by severity, and the full per-check issue list."
msgstr ""

#: app/Common/Abilities/Abilities.php:555
msgid "Get Site SEO Audit"
msgstr ""

#: app/Common/Abilities/Abilities.php:556
msgid "Returns a site-wide SEO health snapshot: homepage score + totals, sitemap on/off, custom robots rule count, public post type list, and GSC connection status."
msgstr ""

#: app/Common/Abilities/Abilities.php:964
msgid "Full TruSEO analysis breakdown. Only present when \"analysis\" is in include."
